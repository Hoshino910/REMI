{
  "name": "dsh-selective-memory",
  "version": "0.3.0-alpha.1",
  "private": true,
  "description": "A DeepSeek Harness transparent memory-window, associative retrieval, and compaction plugin prototype.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm build && vitest run",
    "benchmark": "pnpm --filter @dsh-memory/benchmark benchmark",
    "benchmark:graph": "node packages/benchmark/dist/cli.js examples/benchmark/graph-ablation.jsonl",
    "benchmark:affect": "node packages/benchmark/dist/cli.js examples/benchmark/affect-ablation.jsonl",
    "memory": "node packages/manager/dist/cli.js",
    "validate:offline": "pnpm test && pnpm typecheck && pnpm benchmark:graph",
    "validate:plan": "node packages/benchmark/dist/validation-cli.js plan",
    "validate:score": "node packages/benchmark/dist/validation-cli.js score",
    "validate:local": "node packages/benchmark/scripts/run-paired-validation.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
